	"description": "Central view of tasks, knowledge, and index lines organized by hierarchical tag dimensions.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
